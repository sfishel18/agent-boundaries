{
  "name": "opencode-plugin-boundaries",
  "version": "0.1.1",
  "description": "OpenCode plugin for enforcing agent boundary rules",
  "license": "MIT",
  "type": "module",
  "module": "index.ts",
  "files": [
    "index.ts",
    "src"
  ],
  "scripts": {
    "build": "bun build --outdir=dist index.ts --external @opencode-ai/plugin",
    "test": "bun node_modules/vitest/dist/cli.js run",
    "test:watch": "bun node_modules/vitest/dist/cli.js",
    "link": "mkdir -p ~/.config/opencode/plugins && cp index.ts ~/.config/opencode/plugins/opencode-plugin-boundaries.ts",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "^1.4.3",
    "typescript": "^5"
  },
  "dependencies": {
    "bash-parser": "^0.5.0"
  }
}
