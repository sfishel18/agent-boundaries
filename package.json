{
  "name": "opencode-plugin-boundaries",
  "version": "0.3.0",
  "description": "OpenCode plugin for enforcing agent boundary rules",
  "license": "MIT",
  "type": "module",
  "module": "index.ts",
  "files": [
    "index.ts",
    "src"
  ],
  "scripts": {
    "build": "bun build --outdir=dist index.ts --external @opencode-ai/plugin",
    "test": "bun run vitest --run",
    "test:watch": "bun run vitest",
    "link": "mkdir -p ~/.config/opencode/plugins && cp index.ts ~/.config/opencode/plugins/opencode-plugin-boundaries.ts",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.15.10",
    "@types/bun": "latest",
    "vitest": "^4.1.5"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "^1.15.10",
    "typescript": "^5"
  },
  "dependencies": {
    "bash-parser": "^0.5.0",
    "zod": "^4.4.3"
  }
}
